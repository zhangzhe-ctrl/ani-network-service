#!/usr/bin/env python3
"""Review and return only pinned generator outputs, refusing intervening edits."""
import argparse,hashlib,json,pathlib,shutil,subprocess
p=argparse.ArgumentParser(description=__doc__);p.add_argument('run');p.add_argument('--apply',action='store_true');args=p.parse_args()
root=pathlib.Path(__file__).resolve().parents[1];run=root/'.work/net05a-runs'/args.run;meta=json.loads((run/'snapshot.json').read_text());items={r['path']:r for r in meta['files']}
paths=['internal/conf/v1/conf.pb.go','go.mod','go.sum']+[x for x in items if x.startswith('internal/data/sqlcgen/')]
out=run/'generated';out.mkdir(exist_ok=True);changes=[]
for name in paths:
    local=root/name;f=out/name;f.parent.mkdir(parents=True,exist_ok=True)
    subprocess.run(['scp','-q','-F','/home/chabking/.ssh/config','-o','BatchMode=yes','ubuntu:'+meta['remote']+'/source/'+name,str(f)],check=True)
    assert hashlib.sha256(local.read_bytes()).hexdigest()==items[name]['sha256'],'intervening local edit: '+name
    if local.read_bytes()!=f.read_bytes():
        diff=subprocess.run(['diff','-u',str(local),str(f)],capture_output=True,text=True).stdout
        (out/(pathlib.Path(name).name+'.diff')).write_text(diff)
        changes.append({'path':name,'before':items[name]['sha256'],'after':hashlib.sha256(f.read_bytes()).hexdigest(),'diff':str(out/(pathlib.Path(name).name+'.diff'))})
        if args.apply:shutil.copy2(f,local)
print(json.dumps({'applied':args.apply,'changes':changes},indent=2))
