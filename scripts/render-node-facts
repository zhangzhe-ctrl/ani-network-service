#!/usr/bin/env python3
"""Render read-only node probe manifests from a captured `kubectl get nodes -o json`.
No cluster or host mutations. Apply requires the intended deployment authorization.
"""
import argparse, hashlib, json, re
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--nodes',required=True);p.add_argument('--image',required=True)
p.add_argument('--ovs-socket-uid',required=True,type=int,help='verified numeric owner UID of the OVS socket on every selected node')
a=p.parse_args()
if not 0 <= a.ovs_socket_uid <= 2147483647:p.error('invalid OVS socket owner UID')
if not re.fullmatch(r'[^\s]+@sha256:[0-9a-f]{64}',a.image):p.error('use an immutable built image digest')
nodes=json.load(open(a.nodes))['items'];items=[];seen=set();namespace='kcn-system'
for n in nodes:
 name=n['metadata']['name'];uid=n['metadata']['uid']
 if not re.fullmatch(r'[a-z0-9][a-z0-9.-]{0,252}',name) or not re.fullmatch(r'[a-zA-Z0-9-]{1,128}',uid) or uid in seen:p.error('invalid or duplicate node identity')
 seen.add(uid)
 # Match Go contentHash(string), whose JSON encoder includes quotes.
 stem='ani-node-facts-'+hashlib.sha256(json.dumps(uid,separators=(',',':')).encode()).hexdigest()[:24]
 meta={'name':stem,'namespace':namespace,'labels':{'network.ani.io/managed-by':'ani-network-node-facts','network.ani.io/node-uid':uid}}
 def obj(api,kind,body,metadata=None):return {'apiVersion':api,'kind':kind,'metadata':metadata or meta,**body}
 items.append(obj('v1','ServiceAccount',{'automountServiceAccountToken':False}))
 items.append(obj('v1','ConfigMap',{'data':{}}))
 items.append(obj('rbac.authorization.k8s.io/v1','Role',{'rules':[{'apiGroups':[''],'resources':['configmaps'],'resourceNames':[stem],'verbs':['get','patch']}]}))
 items.append(obj('rbac.authorization.k8s.io/v1','RoleBinding',{'roleRef':{'apiGroup':'rbac.authorization.k8s.io','kind':'Role','name':stem},'subjects':[{'kind':'ServiceAccount','name':stem,'namespace':namespace}]}))
 clusterMeta={'name':stem,'labels':meta['labels']}
 items.append(obj('rbac.authorization.k8s.io/v1','ClusterRole',{'rules':[{'apiGroups':[''],'resources':['nodes'],'resourceNames':[name],'verbs':['get']}]},clusterMeta))
 items.append(obj('rbac.authorization.k8s.io/v1','ClusterRoleBinding',{'roleRef':{'apiGroup':'rbac.authorization.k8s.io','kind':'ClusterRole','name':stem},'subjects':[{'kind':'ServiceAccount','name':stem,'namespace':namespace}]},clusterMeta))
 spec={'nodeName':name,'hostNetwork':True,'dnsPolicy':'ClusterFirstWithHostNet','serviceAccountName':stem,'automountServiceAccountToken':True,'terminationGracePeriodSeconds':15,'tolerations':[{'operator':'Exists'}],
 'securityContext':{'seccompProfile':{'type':'RuntimeDefault'}},
 'containers':[{'name':'facts','image':a.image,'args':['-node-facts'],'env':[{'name':'NETWORK_FACTS_NODE_NAME','value':name},{'name':'NETWORK_FACTS_NODE_UID','value':uid}],
 'securityContext':{'runAsUser':a.ovs_socket_uid,'runAsNonRoot':a.ovs_socket_uid!=0,'allowPrivilegeEscalation':False,'readOnlyRootFilesystem':True,'capabilities':{'drop':['ALL']}},
 'resources':{'requests':{'cpu':'10m','memory':'32Mi'},'limits':{'cpu':'100m','memory':'96Mi'}},
 'volumeMounts':[{'name':'sys','mountPath':'/sys','readOnly':True},{'name':'ovs','mountPath':'/var/run/openvswitch','readOnly':True}]}],
 'volumes':[{'name':'sys','hostPath':{'path':'/sys','type':'Directory'}},{'name':'ovs','hostPath':{'path':'/var/run/openvswitch','type':'Directory'}}]}
 items.append(obj('apps/v1','Deployment',{'spec':{'replicas':1,'strategy':{'type':'Recreate'},'selector':{'matchLabels':{'app':stem}},'template':{'metadata':{'labels':{'app':stem}},'spec':spec}}}))
if not items:p.error('node inventory is empty')
print(json.dumps({'apiVersion':'v1','kind':'List','items':items},indent=2))
