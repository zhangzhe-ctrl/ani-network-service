#!/usr/bin/env python3
"""Bound one task process group and record host-resource samples without secrets."""
import json,os,pathlib,signal,subprocess,sys,time

def memory():
    values={}
    for line in pathlib.Path('/proc/meminfo').read_text().splitlines():
        k,v=line.split(':',1);values[k]=int(v.strip().split()[0])
    return values['MemAvailable'],values['SwapTotal']-values['SwapFree']
start_available,start_swap=memory()
if start_available<1024*1024:raise SystemExit('NET05A resource budget: insufficient available memory')
child=subprocess.Popen(sys.argv[1:],start_new_session=True)
high_load_since=None
run_root = pathlib.Path('.') if pathlib.Path('snapshot.json').is_file() else pathlib.Path('..')
with (run_root/'resources.jsonl').open('a') as log:
    while child.poll() is None:
        available,swap=memory();load=os.getloadavg()[0];disk=os.statvfs('.')
        row={'at':time.time(),'mem_available_kib':available,'swap_used_kib':swap,'load1':load,'disk_free_bytes':disk.f_bavail*disk.f_frsize}
        log.write(json.dumps(row)+'\n');log.flush()
        if load>6:high_load_since=high_load_since or time.monotonic()
        else:high_load_since=None
        if available<1024*1024 or swap-start_swap>256*1024 or row['disk_free_bytes']<20*1024**3 or (high_load_since and time.monotonic()-high_load_since>30):
            print('NET05A task resource stop:',json.dumps(row),flush=True)
            os.killpg(child.pid,signal.SIGTERM)
            try:child.wait(timeout=20)
            except subprocess.TimeoutExpired:os.killpg(child.pid,signal.SIGKILL)
            raise SystemExit(75)
        try:child.wait(timeout=5)
        except subprocess.TimeoutExpired:pass
raise SystemExit(child.returncode)
