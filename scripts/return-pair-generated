#!/usr/bin/env python3
"""Return explicitly named generated files, guarded by the pair's input hashes."""
import hashlib,json,pathlib,shlex,subprocess,sys,tarfile
run=pathlib.Path(sys.argv[1]).resolve();kind=sys.argv[2];paths=sys.argv[3:]
if not paths:raise SystemExit('provide generated paths')
meta=json.loads((run/'snapshot.json').read_text());source=meta['sources'][kind];root=pathlib.Path(source['local']);records={r['path']:r for r in source['files']}
archive=run/(kind+'-generated.tar.gz')
with archive.open('wb') as dest:subprocess.run(['ssh','-F','/home/chabking/.ssh/config','-o','BatchMode=yes','ubuntu','tar -czf - -C '+shlex.quote(meta['remote']+'/'+kind)+' '+shlex.join(paths)],stdout=dest,check=True)
staging=run/(kind+'-returned');staging.mkdir(exist_ok=True)
with tarfile.open(archive) as t:t.extractall(staging,filter='data')
updates=[]
for path in sorted(staging.rglob('*')):
 if not path.is_file():continue
 name=path.relative_to(staging).as_posix();local=root/name;prior=records.get(name)
 if prior:
  if not local.is_file() or hashlib.sha256(local.read_bytes()).hexdigest()!=prior['sha256']:raise SystemExit('concurrent change; refusing '+name)
 elif local.exists():raise SystemExit('unexpected new local file '+name)
 updates.append((local,path))
for local,path in updates:local.parent.mkdir(parents=True,exist_ok=True);local.write_bytes(path.read_bytes())
print('source checked returned files:',len(updates))
