{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "probe-10",
    "namespace": "tenant-egress-0910-1142",
    "labels": {
      "runbook.ani.io/run": "kceg-0910-1142"
    },
    "annotations": {
      "networking.kubercloud.com/subnet": "tenant-egress-0910-1142/kceg-0910-1142-subnet-10"
    }
  },
  "spec": {
